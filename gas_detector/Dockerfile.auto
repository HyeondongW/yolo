# 베이스 이미지: Python 3.8 슬림
FROM python:3.8-slim

# 환경 변수 설정
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 시스템 패키지 설치
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

# 작업 디렉터리 설정
WORKDIR /app

# 의존성 파일 복사 및 설치 (nbconvert 포함)
COPY requirements.txt /app/
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir nbconvert

# 프로젝트 파일 전체 복사
COPY . /app/

# 스크립트 복사 및 실행 권한 부여
COPY run_notebook.sh /app/run_notebook.sh
RUN chmod +x /app/run_notebook.sh

# 컨테이너 시작 시 노트북 스크립트 자동 실행
ENTRYPOINT ["/app/run_notebook.sh"]
